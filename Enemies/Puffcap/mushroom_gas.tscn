[gd_scene format=3 uid="uid://wvsvu224vtm3"]

[sub_resource type="Shader" id="Shader_q5i1o"]
code = "shader_type spatial;

render_mode blend_mix, depth_draw_never, cull_back,
	diffuse_burley, specular_schlick_ggx;


// Base appearance

uniform vec4 albedo : source_color = vec4(0.35, 0.85, 0.28, 0.7);
uniform vec4 secondary_color : source_color = vec4(0.08, 0.28, 0.06, 1.0);
uniform vec4 highlight_color : source_color = vec4(0.65, 1.0, 0.35, 1.0);

uniform sampler2D texture_albedo :
	source_color, filter_linear_mipmap, repeat_enable;

uniform float roughness : hint_range(0.0, 1.0) = 0.85;
uniform float specular : hint_range(0.0, 1.0) = 0.15;
uniform float metallic : hint_range(0.0, 1.0) = 0.0;


// Gas animation

uniform float animation_speed : hint_range(0.0, 5.0) = 0.35;
uniform float gas_scale : hint_range(0.1, 20.0) = 3.5;
uniform float distortion_strength : hint_range(0.0, 2.0) = 0.35;

uniform float displacement_strength : hint_range(0.0, 1.0) = 0.12;
uniform float displacement_scale : hint_range(0.1, 20.0) = 2.5;


// Transparency

uniform float density : hint_range(0.0, 2.0) = 0.75;
uniform float density_contrast : hint_range(0.1, 5.0) = 1.4;
uniform float edge_fade : hint_range(0.1, 8.0) = 1.8;
uniform float dissolve_amount : hint_range(0.0, 1.0) = 0.15;
uniform float dissolve_softness : hint_range(0.001, 0.5) = 0.15;


// Glow

uniform float emission_strength : hint_range(0.0, 10.0) = 1.2;
uniform float highlight_threshold : hint_range(0.0, 1.0) = 0.68;

// Intersection outline

uniform sampler2D depth_texture :
	hint_depth_texture, repeat_disable, filter_nearest;

uniform vec4 intersection_color : source_color =
	vec4(0.8, 1.0, 0.35, 1.0);

uniform float intersection_width :
	hint_range(0.00001, 0.1, 0.00001) = 0.002;

uniform float intersection_emission :
	hint_range(0.0, 20.0, 0.1) = 4.0;

uniform float intersection_alpha :
	hint_range(0.0, 1.0) = 0.85;


// Imported material UV settings

uniform vec3 uv1_scale = vec3(1.0);
uniform vec3 uv1_offset = vec3(0.0);

varying vec3 object_position;


// Random noise

float random_3d(vec3 position) {
	position = fract(position * 0.1031);
	position += dot(position, position.yzx + 33.33);

	return fract(
		(position.x + position.y) * position.z
	);
}


float value_noise_3d(vec3 position) {
	vec3 cell = floor(position);
	vec3 local_position = fract(position);

	// Smooth interpolation.
	local_position =
		local_position * local_position *
		(3.0 - 2.0 * local_position);

	float n000 = random_3d(cell + vec3(0.0, 0.0, 0.0));
	float n100 = random_3d(cell + vec3(1.0, 0.0, 0.0));
	float n010 = random_3d(cell + vec3(0.0, 1.0, 0.0));
	float n110 = random_3d(cell + vec3(1.0, 1.0, 0.0));

	float n001 = random_3d(cell + vec3(0.0, 0.0, 1.0));
	float n101 = random_3d(cell + vec3(1.0, 0.0, 1.0));
	float n011 = random_3d(cell + vec3(0.0, 1.0, 1.0));
	float n111 = random_3d(cell + vec3(1.0, 1.0, 1.0));

	float lower = mix(
		mix(n000, n100, local_position.x),
		mix(n010, n110, local_position.x),
		local_position.y
	);

	float upper = mix(
		mix(n001, n101, local_position.x),
		mix(n011, n111, local_position.x),
		local_position.y
	);

	return mix(lower, upper, local_position.z);
}


float fbm(vec3 position) {
	float result = 0.0;
	float amplitude = 0.5;

	for (int octave = 0; octave < 4; octave++) {
		result += value_noise_3d(position) * amplitude;
		position = position * 2.03 + vec3(13.7, 7.1, 4.6);
		amplitude *= 0.5;
	}

	return result;
}

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;

	vec3 original_position = VERTEX;

	float time = TIME * animation_speed;

	vec3 noise_position =
		original_position * displacement_scale +
		vec3(time * 0.45, -time, time * 0.3);

	float surface_noise = fbm(noise_position);

	// Push the sphere surface in and out.
	VERTEX += NORMAL *
		(surface_noise - 0.5) *
		displacement_strength;

	object_position = original_position;
}


void fragment() {
	float time = TIME * animation_speed;

	vec3 gas_position = object_position * gas_scale;

	// Distort one noise layer using another for less obvious patterns.
	float distortion = fbm(
		gas_position * 0.65 +
		vec3(-time * 0.4, time * 0.7, time * 0.25)
	);

	gas_position +=
		(distortion - 0.5) *
		distortion_strength;

	float gas_noise = fbm(
		gas_position +
		vec3(time * 0.25, -time, time * 0.4)
	);

	// A second moving layer prevents the noise looking stationary.
	float detail_noise = fbm(
		gas_position * 1.8 +
		vec3(-time * 0.7, -time * 1.3, time * 0.55)
	);

	float gas_pattern = mix(
		gas_noise,
		detail_noise,
		0.35
	);

	gas_pattern = pow(
		clamp(gas_pattern, 0.0, 1.0),
		density_contrast
	);

	vec4 albedo_texture = texture(texture_albedo, UV);
	albedo_texture *= COLOR;

	// Darker gas pockets and brighter thin areas.
	vec3 gas_color = mix(
		secondary_color.rgb,
		albedo.rgb,
		smoothstep(0.2, 0.75, gas_pattern)
	);

	float highlights = smoothstep(
		highlight_threshold,
		1.0,
		gas_pattern
	);

	gas_color = mix(
		gas_color,
		highlight_color.rgb,
		highlights
	);

	gas_color *= albedo_texture.rgb;

	// Fade the silhouette of the sphere.
	float facing = abs(dot(
		normalize(NORMAL),
		normalize(VIEW)
	));

	float silhouette_fade = pow(
		clamp(facing, 0.0, 1.0),
		edge_fade
	);

	// Break up transparent sections within the gas.
	float dissolved_density = smoothstep(
		dissolve_amount,
		dissolve_amount + dissolve_softness,
		gas_pattern
	);

	float final_alpha =
		gas_pattern *
		dissolved_density *
		silhouette_fade *
		density *
		albedo.a *
		albedo_texture.a;

	// Read the depth of opaque geometry behind the gas.
	float raw_scene_depth = texture(
		depth_texture,
		SCREEN_UV
	).r;

		// Depth of the nearest opaque mesh at this pixel.
	float scene_depth = textureLod(
		depth_texture,
		SCREEN_UV,
		0.0
	).r;

	/*
	Godot uses reversed-Z depth:
	- Near objects have larger depth values.
	- Distant objects have smaller depth values.

	If the gas is in front of an object, this value is positive.
	*/
	float depth_difference =
		FRAGCOORD.z - scene_depth;

	float intersection = 1.0 - smoothstep(
		0.0,
		intersection_width,
		depth_difference
	);

	// Reject geometry positioned in front of the gas.
	intersection *= step(
		0.0,
		depth_difference
	);

	// A scene depth of zero represents the distant background.
	intersection *= step(
		0.000001,
		scene_depth
	);

	vec3 final_color = mix(
		gas_color,
		intersection_color.rgb,
		intersection
	);

	float final_emission_strength =
		(highlights * 0.7 + gas_pattern * 0.3) *
		emission_strength;

	ALBEDO = final_color;
	ROUGHNESS = roughness;
	SPECULAR = specular;
	METALLIC = metallic;

	EMISSION =
		gas_color * final_emission_strength +
		intersection_color.rgb *
		intersection *
		intersection_emission;

	final_alpha = max(
		final_alpha,
		intersection * intersection_alpha
	);

	ALPHA = clamp(final_alpha, 0.0, 1.0);
}"

